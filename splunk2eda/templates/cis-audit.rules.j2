# {{ ansible_managed | default('Managed by Ansible') }}
# CIS Red Hat Enterprise Linux 9 Benchmark v2.0.0 - section 6.3.3 auditd rules
# Not included here:
#   6.3.3.1  sudoers         -> 50-sudoers.rules
#   6.3.3.20 immutable (-e 2) -> 99-finalize.rules
{% set uid_min = audit_uid_min | default(1000) %}
{% set auid = '-F auid>=' ~ uid_min ~ ' -F auid!=unset' %}

## 6.3.3.2 - Actions run as another user
-a always,exit -F arch=b64 -C euid!=uid -F auid!=unset -S execve -k user_emulation
-a always,exit -F arch=b32 -C euid!=uid -F auid!=unset -S execve -k user_emulation
{% if audit_sudo_log is defined %}

## 6.3.3.3 - Sudo log file
-w {{ audit_sudo_log }} -p wa -k sudo_log_file
{% endif %}

## 6.3.3.4 - Date and time changes
-a always,exit -F arch=b64 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b64 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b32 -S clock_settime -F a0=0x0 -k time-change
-w /etc/localtime -p wa -k time-change

## 6.3.3.5 - Network environment
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/hostname -p wa -k system-locale
-w /etc/sysconfig/network -p wa -k system-locale
-w /etc/sysconfig/network-scripts/ -p wa -k system-locale
-w /etc/NetworkManager/ -p wa -k system-locale
{% if audit_privileged_cmds | default([]) | length > 0 %}

## 6.3.3.6 - Privileged commands (setuid/setgid binaries)
{% for cmd in audit_privileged_cmds | sort %}
-a always,exit -F path={{ cmd }} -F perm=x {{ auid }} -k privileged
{% endfor %}
{% endif %}

## 6.3.3.7 - Failed file access attempts
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES {{ auid }} -k access
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM {{ auid }} -k access
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES {{ auid }} -k access
-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM {{ auid }} -k access

## 6.3.3.8 - User and group information
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/nsswitch.conf -p wa -k identity
-w /etc/pam.conf -p wa -k identity
-w /etc/pam.d/ -p wa -k identity

## 6.3.3.9 - Permission and ownership changes
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat {{ auid }} -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat {{ auid }} -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr {{ auid }} -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat {{ auid }} -k perm_mod
-a always,exit -F arch=b32 -S chown,fchown,lchown,fchownat {{ auid }} -k perm_mod
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr {{ auid }} -k perm_mod

## 6.3.3.10 - Successful filesystem mounts
-a always,exit -F arch=b64 -S mount {{ auid }} -k mounts
-a always,exit -F arch=b32 -S mount {{ auid }} -k mounts

## 6.3.3.11 - Session start
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session

## 6.3.3.12 - Login and logout
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins

## 6.3.3.13 - File deletes and renames
-a always,exit -F arch=b64 -S rename,unlink,unlinkat,renameat {{ auid }} -k delete
-a always,exit -F arch=b32 -S rename,unlink,unlinkat,renameat {{ auid }} -k delete

## 6.3.3.14 - SELinux policy changes
-w /etc/selinux/ -p wa -k MAC-policy
-w /usr/share/selinux/ -p wa -k MAC-policy

## 6.3.3.15-17 - chcon, setfacl, chacl
-a always,exit -F path=/usr/bin/chcon -F perm=x {{ auid }} -k perm_chng
-a always,exit -F path=/usr/bin/setfacl -F perm=x {{ auid }} -k perm_chng
-a always,exit -F path=/usr/bin/chacl -F perm=x {{ auid }} -k perm_chng

## 6.3.3.18 - usermod
-a always,exit -F path=/usr/sbin/usermod -F perm=x {{ auid }} -k usermod

## 6.3.3.19 - Kernel module loading and unloading
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module,create_module,query_module {{ auid }} -k kernel_modules
-a always,exit -F path=/usr/bin/kmod -F perm=x {{ auid }} -k kernel_modules
